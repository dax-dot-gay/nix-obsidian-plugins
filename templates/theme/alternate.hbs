"{{kebabCase name}}" = (
    let
        baseUrl = "https://github.com/{{{repo}}}.git";
    in
    pkgs.stdenvNoCC.mkDerivation {
        pname = "{{kebabCase name}}";
        version = "{{{revision}}}";
        outputHash = "{{{hash}}}";
        outputHashMode = "recursive";
        outputHashAlgo = "sha256";

        nativeBuildInputs = [pkgs.mktemp pkgs.git];
        SSL_CERT_FILE = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
        phases = ["installPhase"];
        installPhase = ''
            temp="$(mktemp -d)"
            GIT_SSL_NO_VERIFY=true git clone --revision={{{revision}}} --depth=1 ${baseUrl} $temp/archive
            mkdir -p $out
            cp $temp/archive/manifest.json $out/manifest.json
            cp $temp/archive/obsidian.css $out/obsidian.css
            rm -rf $temp
        '';
        meta = {
            description = ''{{description}}'';
            homepage = "https://github.com/{{{repo}}}";
        };
    }
);